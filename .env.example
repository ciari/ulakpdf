# Copy to `.env` and adjust per environment.

# ----- Public-facing URL of the SP (the nginx-shib container) -----
# Used to compute the SAML AssertionConsumerService URL the IdP redirects to.
HTTP_PORT=8081
SP_HOSTNAME=localhost
SP_BASE_URL=http://localhost:8081
SP_ENTITY_ID=https://localhost:8081/shibboleth

# ----- IdP (defaults point at the bundled SimpleSAMLphp test IdP) -----
IDP_PORT=8082
# Entity ID is what the IdP itself issues — must match its baseurlpath, NOT
# the URL shibd uses to fetch metadata. The metadata URL is internal-only.
IDP_ENTITY_ID=http://localhost:8082/simplesaml/saml2/idp/metadata.php
IDP_METADATA_URL=http://test-idp:8080/simplesaml/saml2/idp/metadata.php
SP_BASE_URL_PUBLIC_IDP=http://localhost:8082/simplesaml/
IDP_ADMIN_PASSWORD=changeme
IDP_SECRET_SALT=please-change-me-please

# ----- Locale / upload limits (kept for template parity; unused by BentoPDF) -----
SYSTEM_DEFAULTLOCALE=tr-TR
SYSTEM_MAXFILESIZE=200

# ----- Shib SP error contact -----
SUPPORT_CONTACT=admin@example.org

# ----- Branding (build-time, requires `docker compose build bentopdf`) -----
VITE_BRAND_NAME=UlakPDF
VITE_FOOTER_TEXT=© 2026 Ulakbim Bulut. All rights reserved.

# ----- BentoPDF replica count (load-balanced by nginx) -----
BENTOPDF_REPLICAS=3

# ----- Admin allow-list for /stats/ dashboard -----
ADMIN_EPPNS=user1@stirling.local
