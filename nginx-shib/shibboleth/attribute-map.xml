<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maps SAML attributes from the IdP into Variable-* HTTP headers nginx can
  pick up via shib_request_set. The "id" becomes the header suffix:
    id="eppn"  ->  Variable-eppn  ->  $shib_eppn in nginx
-->
<Attributes xmlns="urn:mace:shibboleth:2.0:attribute-map"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <!-- eduPerson core -->
    <Attribute name="urn:oid:1.3.6.1.4.1.5923.1.1.1.6"  id="eppn"/>
    <Attribute name="urn:oid:1.3.6.1.4.1.5923.1.1.1.9"  id="affiliation"/>
    <Attribute name="urn:oid:1.3.6.1.4.1.5923.1.1.1.7"  id="entitlement"/>
    <Attribute name="urn:oid:1.3.6.1.4.1.5923.1.1.1.10" id="persistent-id">
        <AttributeDecoder xsi:type="NameIDAttributeDecoder"
                          formatter="$NameQualifier!$SPNameQualifier!$Name"
                          defaultQualifiers="true"/>
    </Attribute>
    <Attribute name="urn:oid:1.3.6.1.4.1.5923.1.1.1.13" id="subject-id"/>
    <Attribute name="urn:oid:1.3.6.1.4.1.5923.1.1.1.16" id="pairwise-id"/>

    <!-- Personal info -->
    <Attribute name="urn:oid:0.9.2342.19200300.100.1.3"  id="mail"/>
    <Attribute name="urn:oid:2.5.4.42"                   id="givenName"/>
    <Attribute name="urn:oid:2.5.4.4"                    id="sn"/>
    <Attribute name="urn:oid:2.16.840.1.113730.3.1.241"  id="displayName"/>
    <Attribute name="urn:oid:0.9.2342.19200300.100.1.1"  id="uid"/>
    <Attribute name="urn:oid:2.5.4.3"                    id="cn"/>

    <!-- Common SAML 2.0 friendly-name fallbacks. The test IdP
         (kristophjunge/test-saml-idp / SimpleSAMLphp) sends these with
         nameFormat=basic, NOT the default uri. Without nameFormat="...:basic"
         shibd silently skips them and shibauthorizer treats every request
         as unauthenticated. -->
    <Attribute name="eduPersonPrincipalName" id="eppn"
               nameFormat="urn:oasis:names:tc:SAML:2.0:attrname-format:basic"/>
    <Attribute name="mail" id="mail"
               nameFormat="urn:oasis:names:tc:SAML:2.0:attrname-format:basic"/>
    <Attribute name="displayName" id="displayName"
               nameFormat="urn:oasis:names:tc:SAML:2.0:attrname-format:basic"/>
    <Attribute name="givenName" id="givenName"
               nameFormat="urn:oasis:names:tc:SAML:2.0:attrname-format:basic"/>
    <Attribute name="sn" id="sn"
               nameFormat="urn:oasis:names:tc:SAML:2.0:attrname-format:basic"/>
    <Attribute name="cn" id="cn"
               nameFormat="urn:oasis:names:tc:SAML:2.0:attrname-format:basic"/>
    <Attribute name="uid" id="uid"
               nameFormat="urn:oasis:names:tc:SAML:2.0:attrname-format:basic"/>
    <Attribute name="eduPersonAffiliation" id="affiliation"
               nameFormat="urn:oasis:names:tc:SAML:2.0:attrname-format:basic"/>

</Attributes>
