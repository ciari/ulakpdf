# UlakPDF — Production .env, ulakpdf.tr için Yetkim federasyon-modu.
# /opt/spdf/.env olarak kopyalayıp DEĞER tarafını kontrol edip kullanın.
#
# Yetkim'e özgü URL'ler (federasyon metadata + Discovery Service) Yetkim
# self-servis portalinden (https://yetkim.org.tr) edinilir; aşağıdaki
# yer tutucular yaygın paterne göre yazılmıştır, KESİNLİKLE doğrulayın.

# =========================================================================
# Public URL — host nginx + certbot bunu kullanır
# =========================================================================
DOMAIN=ulakpdf.tr
SP_HOSTNAME=ulakpdf.tr
SP_BASE_URL=https://ulakpdf.tr
# SP entity ID (Yetkim'e bu değerle SP olarak kaydolacaksın).
SP_ENTITY_ID=https://ulakpdf.tr/shibboleth

HTTP_PORT=8081

# =========================================================================
# Yetkim federasyon-modu (canlı endpoint'ler — yetkim.org.tr'den doğrulandı)
# =========================================================================
# Federasyon agregat metadata — Yetkim'in 181 üye IdP'sini içerir.
# İmzalı XML, 5 saatte bir refresh. shibd başlangıçta indirip cache'ler.
IDP_METADATA_URL=https://md.yetkim.org.tr/yetkim-metadata.xml

# Discovery Service / WAYF — "Yetkim SSO" tıklayınca kullanıcı buraya
# yönlendirilir, kurumunu seçer, geri döner. SAMLDS protokolü.
IDP_DISCOVERY_URL=https://ds.yetkim.org.tr/

# IDP_ENTITY_ID federasyon modunda kullanılmıyor — boş bırak. Tek-IdP
# moduna geçmek istersen IDP_DISCOVERY_URL'ı kaldır ve buraya o IdP'nin
# entityID'sini yaz.
IDP_ENTITY_ID=

# =========================================================================
# Destek / iletişim
# =========================================================================
SUPPORT_CONTACT=destek@kurum.edu.tr

# =========================================================================
# Marka (build-time — değiştirince `docker compose build bentopdf` gerek)
# =========================================================================
VITE_BRAND_NAME=UlakPDF
VITE_FOOTER_TEXT=© 2026 ULAKBİM. Tüm hakları saklıdır.

# =========================================================================
# Yönetici eppn allow-list (virgül ayrılmış, /stats/ paneline erişim)
# =========================================================================
# Federasyon modunda eppn formatı 'kullanici@kurum.tr' şeklindedir.
# İlk girişten sonra https://ulakpdf.tr/Shibboleth.sso/Session adresinde
# kendi eppn'ini görüp birebir kopyalaman en güvenlisi.
ADMIN_EPPNS=admin@kurum.edu.tr,diger-admin@kurum.edu.tr

# =========================================================================
# Locale + upload limit (BentoPDF kullanmıyor ama template tutarlılığı için)
# =========================================================================
SYSTEM_DEFAULTLOCALE=tr-TR
SYSTEM_MAXFILESIZE=200

# =========================================================================
# Loglama
# =========================================================================
# Container'lar default json-file driver kullanır (docker logs çalışır).
# Stats ve shibd transaction logları HOST rsyslog'u tarafından
# loghost.example.tr'ye forward edilir — bkz. deploy/rsyslog/ulakpdf.conf.
# Burada başka bir env ayarına gerek yok.
