# UlakPDF production environment.
# Copy to /opt/spdf/.env and fill in real values before running deploy.sh.

# =========================================================================
# Public URL
# =========================================================================
# The domain users browse to. Must match the certbot certificate.
DOMAIN=ulakpdf.example.tr

# Computed once domain is set — DO NOT change unless you really mean to.
SP_HOSTNAME=${DOMAIN}
SP_BASE_URL=https://${DOMAIN}
# Convention: HTTPS URL of the SP, ends with /shibboleth. This is what you
# register with Yetkim.
SP_ENTITY_ID=https://${DOMAIN}/shibboleth

# The docker stack only listens on loopback; host nginx terminates TLS.
HTTP_PORT=8081

# =========================================================================
# Yetkim IdP — fill in from Yetkim self-service portal
# =========================================================================
# Entity ID of the Yetkim IdP (something like https://idp.yetkim.gov.tr/idp/shibboleth).
IDP_ENTITY_ID=https://idp.yetkim.example.tr/idp/shibboleth
# Federation/IdP metadata URL — shibd fetches this on boot and on refresh.
IDP_METADATA_URL=https://idp.yetkim.example.tr/idp/shibboleth

# Optional: path inside the nginx-shib container to the Yetkim federation
# signing certificate. If you place a file at
# nginx-shib/shibboleth/federation-cert.pem before building, it ends up at
# /etc/shibboleth/federation-cert.pem and you can reference it from
# shibboleth2.xml's MetadataFilter type="Signature". Leave blank to skip
# signature verification (NOT recommended for prod).

# =========================================================================
# Support / contact
# =========================================================================
SUPPORT_CONTACT=destek@example.tr

# =========================================================================
# Branding (build-time — change requires `docker compose build bentopdf`)
# =========================================================================
VITE_BRAND_NAME=UlakPDF
VITE_FOOTER_TEXT=© 2026 Ulakbim Bulut. All rights reserved.

# =========================================================================
# Admin allow-list for the /stats/ dashboard (comma-separated eppns)
# =========================================================================
ADMIN_EPPNS=admin@example.tr,another-admin@example.tr

# =========================================================================
# Stirling-style locale + upload limit (unused by BentoPDF but kept for
# template consistency — safe to leave defaults)
# =========================================================================
SYSTEM_DEFAULTLOCALE=tr-TR
SYSTEM_MAXFILESIZE=200

# =========================================================================
# Remote syslog — every container's stdout/stderr is shipped via UDP to
# ULAKBİM's central log host. nginx access logs are tee'd to stdout
# inside the container so they ride this pipe too.
# =========================================================================
SYSLOG_ADDRESS=udp://loghost.ulakbim.gov.tr:514
SYSLOG_FORMAT=rfc5424
SYSLOG_FACILITY=local6
# Uncomment to fall back to local json-file logging (re-enables `docker logs`).
#SYSLOG_DRIVER=json-file
